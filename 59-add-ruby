#!/usr/bin/env bash
# Ruby

if [[ ${rubyFlag:-false} == true ]]; then
  log_info "Installing Ruby..."
else
  log_info "Ruby skipped."
  return;
fi

# A mise-managed Ruby can coexist with distribution packages. Do not remove
# packages that Omarchy or another application may depend on.

if command -v mise &>/dev/null; then
  mise use -g "$rubyVersion" && log_pass "Ruby installed via mise."
  hash -r
else
  log_fail "mise not found — cannot install Ruby."
  return;
fi
