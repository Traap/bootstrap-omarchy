#!/usr/bin/env bash

if [[ ${starshipFlag:-false} != true ]]; then
  log_info 'Starship Prompt skipped.'
  return 0
fi

# Upstream uses exit 1 for both cancellation and errors. Confirm here so the
# runner can distinguish an intentional skip from a failed installation.
starship_answer=''
IFS= read -r -p 'Install/update Starship? [y/N] ' starship_answer || starship_answer=''
case ${starship_answer,,} in
  y|yes) ;;
  *)
    log_info 'Starship installation declined; continuing migration.'
    return 77
    ;;
esac

log_info 'Installing Starship Prompt.'
run_installer "https://starship.rs/install.sh" sh --yes
