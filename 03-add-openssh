#!/usr/bin/env bash
# openssh

if [[ ${openSSLFlag:-false} == true ]]; then
  log_info 'Installing OpenSSH and OpenSSL.'
else
  log_info 'openssl skipped.'
  return;
fi

# Install OpenSSH and OpenSSL
log_info "Installing OpenSSH and OpenSSL..."
sudo pacman -S --noconfirm --noprogressbar --needed openssh openssl

# Server startup is independent of installing client tools and libraries.
if [[ ${sshServerFlag:-false} == true ]]; then
  log_info "Enabling and starting sshd service..."
  sudo systemctl enable --now sshd.service
  sudo systemctl --no-pager --full status sshd.service
fi

log_info "Verifying installed versions"
ssh -V
openssl version
