#!/usr/bin/env bash
# {{{ Check symnlinksFlag

if [[ ${symlinksFlag:-false} == true ]]; then
  log_info 'Install symlinks.'
else
  log_info 'symlinks skipped.'
  return;
fi

# -------------------------------------------------------------------------- }}}
# {{{ Create symbolic links

createSymLinks() {
  log_info "Creating symbolic links."
  mkdir -p ~/.config

    # Symlinks at .config
    safe_link "$dotfiles/ghostty"                "$HOME/.config/ghostty"
    safe_link "$dotfiles/gits"                   "$HOME/.config/gits"
    safe_link "$dotfiles/starship/starship.toml" "$HOME/.config/starship.toml"
    safe_link "$dotfiles/yazi"                   "$HOME/.config/yazi"
    safe_link "$cloneRoot/nvim.traap"            "$HOME/.config/nvim"
    configure_tmux_links "$cloneRoot/tmux"

    # Symlinks at $HOME
    safe_link "$dotfiles/bash/inputrc"          "$HOME/.inputrc"
    safe_link "$dotfiles/bash/xinitrc"          "$HOME/.xinitrc"
    safe_link "$dotfiles/git/gitconfig"         "$HOME/.gitconfig"
    safe_link "$dotfiles/git/gitignore_global"  "$HOME/.gitignore_global"
    safe_link "$dotfiles/latex/latexmkrc"       "$HOME/.latexmkrc"
    safe_link "$cloneRoot/ssh/config.vim"       "$HOME/.config.vim"
    # SSH directory reconciliation belongs to 04-add-ssh-keys.
    safe_link "$cloneRoot/vim"                  "$HOME/.vim"
    safe_link "$cloneRoot/vim/vimrc"            "$HOME/.vimrc"
}

# -------------------------------------------------------------------------- }}}
# {{{ Create configured symbolic links

createSymLinks

# -------------------------------------------------------------------------- }}}
