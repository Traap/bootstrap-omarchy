#!/usr/bin/env bash
# luarocks packages

if [[ ${luarocksFlag:-false} == true ]]; then
  log_info "Installing LuaRocks packages..."
else
  log_info "LuaRocks packages skipped."
  return;
fi

# Install lua rocks
luarocks_packages=(
  jsregexp
)

sudo pacman -S --noconfirm --noprogressbar --needed luarocks lua51
require_cmd luarocks
for pkg in "${luarocks_packages[@]}"; do
  sudo luarocks --lua-version=5.1 install "$pkg"
done
log_pass "LuaRocks packages installed for Lua 5.1."
