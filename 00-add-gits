#!/usr/bin/env bash
# gits

if [[ ${gitsFlag:-false} == true ]]; then
  log_info 'Installing gits.'
else
  log_info 'Gits skipped.'
  return;
fi

# Install Traap gits
run_installer "https://raw.githubusercontent.com/Traap/gits/master/install.sh" bash

# Render the bundled locations with the same root used by the other steps.
require_cmd python3
(
  locations=$(mktemp)
  trap 'rm -f -- "$locations"' EXIT
  python3 "$MIGRATION_ROOT/scripts/repository-locations.py" "$MIGRATION_ROOT/repository_locations.yml" "$cloneRoot" > "$locations"
  config_path="${XDG_CONFIG_HOME:-$HOME/.config}/gits/repository_locations.yml"
  install_user_file "$locations" "$config_path"
)
require_cmd gits

# Rehash cached commands. Runtime paths are initialized in functions.
hash -r
