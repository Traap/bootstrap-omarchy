#!/usr/bin/env bash
# add-wsl

if [[ ${wslFlag:-false} == true ]]; then
  log_info 'Install wsl.'
else
  log_info 'wsl skipped.'
  return;
fi

[[ ${targetProfile:-desktop} == wsl ]] || {
  log_fail '85-add-wsl requires targetProfile=wsl.'
  return 1
}

is_wsl || { log_fail "WSL configuration requested on a non-WSL kernel."; return 1; }
require_cmd python3
[[ $wslHostName =~ ^[[:alnum:]][[:alnum:].-]*$ && $wslUserName =~ ^[a-z_][a-z0-9_-]*\$?$ ]] || {
  log_fail "Invalid WSL hostname or user name."
  return 1
}
(
  wsl_config=$(mktemp)
  trap 'rm -f -- "$wsl_config"' EXIT
  if sudo test -f /etc/wsl.conf; then
    sudo cat /etc/wsl.conf
  else
    cat "$MIGRATION_ROOT/wsl-template.conf"
  fi | python3 "$MIGRATION_ROOT/scripts/merge-ini.py" \
    network hostname "$wslHostName" user default "$wslUserName" \
    interop enabled true interop appendWindowsPath false > "$wsl_config"
  install_system_file "$wsl_config" /etc/wsl.conf
)
