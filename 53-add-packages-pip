#!/usr/bin/env bash
# Isolated Python CLI applications
set -euo pipefail

if [[ ${pythonCliPackagesFlag:-false} == true ]]; then
  log_info "Installing isolated Python CLI applications..."
else
  log_info "Python CLI applications skipped."
  return;
fi

# Additional Python CLI applications.
pip_packages=(
  neovim-remote
)

# Install CLI applications in isolated environments, not system Python.
sudo pacman -S --noconfirm --noprogressbar --needed python-pipx
require_cmd pipx
for pkg in "${pip_packages[@]}"; do
  pipx install --force "$pkg"
done
log_pass "Python CLI applications installed."
