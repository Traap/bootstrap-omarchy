#!/usr/bin/env bash
# pip packages
set -euo pipefail

if [[ ${pipPackagesFlag:-false} == true ]]; then
  log_info "Installing pip packages..."
else
  log_info "pip packages skipped."
  return;
fi

# Instal pip packages.
pip_packages=(
  neovim-remote
)

# Install CLI applications in isolated environments, not system Python.
sudo pacman -S --noconfirm --noprogressbar --needed python-pipx
require_cmd pipx
for pkg in "${pip_packages[@]}"; do
  pipx install --force "$pkg"
done
log_pass "Python CLI applications installed."
