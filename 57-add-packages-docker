#!/usr/bin/env bash
# Docker

if [[ ${dockerPackagesFlag:-false} == true ]]; then
  log_info 'Install docker packages.'
else
  log_info 'docker packages skipped.'
  return;
fi

# Socker setup
docker_packages=(
  "docker"
  "docker-buildx"
  "docker-compose"
)

log_info 'pacman -S --noconfirm  --noprogressbar --needed ${docker_packages[@]}'
sudo pacman -S --noconfirm  --noprogressbar --needed "${docker_packages[@]}"

log_info 'sudo systemctl enable docker.service --now'
sudo systemctl enable docker.service --now

log_info 'sudo systemctl --no-pager --full status docker.service'
sudo systemctl --no-pager --full status docker.service
