#!/usr/bin/env bash
# 11-generate-utf-8

if [[ ${utf8Flag:-false} == true ]]; then
  log_info 'Generating UTF-8.'
else
  log_info 'UTF-8 generation skipped.'
  return
fi

# {{{ 1. Ensure en_US.UTF-8 UTF-8 is uncommented in /etc/locale.gen
#        - Handles commented and already-uncommented cases safely

(
  locale_gen=$(mktemp)
  trap 'rm -f -- "$locale_gen"' EXIT
  sudo cat /etc/locale.gen | sed \
    -e 's/^[[:space:]]*#\([[:space:]]*en_US\.UTF-8[[:space:]]\+UTF-8\)/\1/' > "$locale_gen"
  grep -Eq '^[[:space:]]*en_US\.UTF-8[[:space:]]+UTF-8([[:space:]]|$)' "$locale_gen" || {
    log_fail 'en_US.UTF-8 was not found in /etc/locale.gen.'
    exit 1
  }
  install_system_file "$locale_gen" /etc/locale.gen
)

# -------------------------------------------------------------------------- }}}
# {{{ 2. Generate locales

sudo locale-gen

# -------------------------------------------------------------------------- }}}
# {{{ 3. Set the system locale explicitly (Arch standard)

(
  locale_config=$(mktemp)
  trap 'rm -f -- "$locale_config"' EXIT
  if [[ -f /etc/locale.conf ]]; then
    sudo cat /etc/locale.conf | sed '/^[[:space:]]*LANG=/d' > "$locale_config"
  fi
  printf '%s\n' 'LANG=en_US.UTF-8' >> "$locale_config"
  install_system_file "$locale_config" /etc/locale.conf
)
