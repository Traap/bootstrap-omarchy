#!/usr/bin/env bash
# Configure Samba/SSSD and join Active Directory.
if [[ ${adFlag:-false} != true ]]; then
  log_info 'Active Directory integration skipped.'
  return 0
fi

# Reject newlines and config syntax before rendering privileged configuration.
[[ $AD_DOMAIN =~ ^[[:alnum:]][[:alnum:].-]*$ && $AD_REALM =~ ^[[:alnum:]][[:alnum:].-]*$ ]] || {
  log_fail 'Invalid Active Directory domain or realm.'
  return 1
}
sudo pacman -S --noconfirm --noprogressbar --needed samba krb5 sssd python iproute2
require_cmd net testparm sssctl kinit getent
source "$MIGRATION_ROOT/scripts/ad-access.sh"
# DNS lookup checks the configured network path without relying on ICMP.
getent hosts "$AD_DOMAIN" >/dev/null || {
  log_fail 'AD DNS is unavailable. Reconnect to the domain network and rerun this step.'
  return 1
}
sudo systemctl enable --now systemd-timesyncd
[[ $(timedatectl show -p NTPSynchronized --value) == yes ]] || {
  log_fail 'System time is not synchronized; retry after synchronization.'
  return 1
}

(
  ad_dir=$(mktemp -d)
  trap 'rm -rf -- "$ad_dir"' EXIT
  umask 077
  cat > "$ad_dir/krb5.conf" <<CONFIG
[libdefaults]
  default_realm = $AD_REALM
  dns_lookup_realm = true
  dns_lookup_kdc = true
  rdns = false
CONFIG
  # Validate the candidate with Kerberos before replacing the system file.
  KRB5_CONFIG="$ad_dir/krb5.conf" kinit "${AD_USER}@${AD_REALM}"
  install_system_file "$ad_dir/krb5.conf" /etc/krb5.conf
  cat > "$ad_dir/smb.conf" <<CONFIG
[global]
   workgroup = ${AD_REALM%%.*}
   security = ADS
   realm = $AD_REALM
   kerberos method = secrets and keytab
   template shell = /bin/bash
CONFIG
  testparm -s "$ad_dir/smb.conf" >/dev/null
  install_system_file "$ad_dir/smb.conf" /etc/samba/smb.conf
  if ! sudo net ads testjoin; then
    sudo net ads join -U "$AD_USER"
  fi
  sudo mkdir -p /etc/sssd
  cat > "$ad_dir/sssd.conf" <<CONFIG
[sssd]
services = nss, pam
config_file_version = 2
domains = $AD_DOMAIN

[domain/$AD_DOMAIN]
id_provider = ad
access_provider = ad
auth_provider = ad
chpass_provider = ad
ad_domain = $AD_DOMAIN
krb5_realm = $AD_REALM
cache_credentials = True
fallback_homedir = /home/%u
default_shell = /bin/bash
CONFIG
  sudo chown root:root "$ad_dir/sssd.conf"
  sudo sssctl config-check --config "$ad_dir/sssd.conf" --snippet /etc/sssd/conf.d
  install_system_file "$ad_dir/sssd.conf" /etc/sssd/sssd.conf 0600
)
sudo systemctl enable --now sssd.service
sudo systemctl restart sssd.service
sudo net ads testjoin
getent passwd "${AD_USER}@${AD_DOMAIN}"
log_pass 'Active Directory integration verified.'
