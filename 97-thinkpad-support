#!/usr/bin/env bash
if [[ ${thinkpadSupportFlag:-false} != true ]]; then
  log_info 'ThinkPad sensors and dock drivers skipped.'
  return 0
fi
is_thinkpad || { log_info 'No ThinkPad detected; hardware setup skipped.'; return 77; }
sudo pacman -S --noconfirm --noprogressbar --needed i2c-tools lm_sensors usbutils
sudo sensors-detect --auto
# Optional dock NIC modules: availability depends on the installed kernel.
for module in ax88179_178a cdc_ncm r8152; do
  sudo modprobe "$module" || log_warn "Optional dock driver unavailable: $module"
done
log_pass 'ThinkPad sensors and dock drivers configured; power policy preserved.'
