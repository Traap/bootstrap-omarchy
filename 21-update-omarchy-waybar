#!/usr/bin/env bash
# Optional legacy Waybar setup. Omarchy Quattro uses Quickshell by default.

if [[ ${waybarFlag:-false} == true ]]; then
  log_warn 'Installing optional Waybar configuration; Quattro uses Omarchy Shell by default.'
else
  log_info 'waybar skipped.'
  return;
fi

source_dir="$dotfiles/waybar"
target="$HOME/.config/waybar"
[[ -d $source_dir ]] || { log_fail "Waybar configuration not found: $source_dir"; return 1; }

if [[ -e $target || -L $target ]]; then
  backup="$target.bak.$(date +%Y%m%d-%H%M%S)"
  mv -v "$target" "$backup"
  log_warn "Backed up existing Waybar configuration to $backup"
fi
ln -s "$source_dir" "$target"
