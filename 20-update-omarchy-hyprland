#!/usr/bin/env bash
# hyprland

if [[ ${hyprlandOverridesFlag:-false} == true ]]; then
  log_info 'Linking personal Hyprland overrides.'
else
  log_info 'Hyprland overrides skipped.'
  return
fi

# Quattro owns hyprland.lua and layers these user modules after its defaults.
source_dir="$dotfiles/hypr"
target_dir="$HOME/.config/hypr"
override_files=(monitors.lua input.lua bindings.lua looknfeel.lua autostart.lua)

[[ -d $source_dir ]] || { log_fail "Hyprland overrides not found: $source_dir"; return 1; }
mkdir -p "$target_dir"

if [[ ! -f $target_dir/hyprland.lua ]]; then
  omarchy_source="${OMARCHY_PATH:-/usr/share/omarchy}/config/hypr/hyprland.lua"
  [[ -f $omarchy_source ]] || {
    log_fail "Quattro Hyprland entry point not found: $omarchy_source"
    return 1
  }
  cp -v "$omarchy_source" "$target_dir/hyprland.lua"
fi

for file in "${override_files[@]}"; do
  [[ -f $source_dir/$file ]] || { log_info "No override supplied for $file"; continue; }
  safe_link "$source_dir/$file" "$target_dir/$file"
done

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl &>/dev/null; then
  hyprctl reload
  config_errors=$(hyprctl configerrors)
  if [[ -n $config_errors && $config_errors != ok ]]; then
    log_fail "$config_errors"
    return 1
  fi
fi
