#!/usr/bin/env bash
# Create a personal SSH authentication key.

if [[ ${sshHostKeyFlag:-false} != true ]]; then
  log_info 'SSH key setup skipped.'
  return 0
fi

if ! command -v ssh-keygen >/dev/null 2>&1; then
  log_fail 'ssh-keygen is required; enable the OpenSSH installation step first.'
  return 1
fi

if [[ ! ${archHostName:-} =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]]; then
  log_fail 'archHostName must start with a letter or number and contain only letters, numbers, dots, underscores, or hyphens.'
  return 1
fi

sshDir="${cloneRoot:?cloneRoot must be configured}/ssh"
template="$(dirname -- "${BASH_SOURCE[0]}")/ssh-config-template"

# Never replace an existing SSH directory or a link to another directory.
if [[ -e $HOME/.ssh || -L $HOME/.ssh ]]; then
  if [[ ! -L $HOME/.ssh || $(readlink -m -- "$HOME/.ssh") != $(readlink -m -- "$sshDir") ]]; then
    log_fail "Existing $HOME/.ssh does not point to $sshDir; reconcile it before running this step."
    return 1
  fi
fi

[[ $sshDir == /* ]] || { log_fail "cloneRoot must be an absolute path."; return 1; }
for key_file in "$sshDir/$archHostName" "$sshDir/$archHostName.pub"; do
  if [[ -L $key_file || ( -e $key_file && ! -f $key_file ) ]]; then
    log_fail "SSH key must be a regular file: $key_file"
    return 1
  fi
done
if [[ ( -e $sshDir/config || -L $sshDir/config ) && ! -f $sshDir/config ]]; then
  log_fail "SSH configuration must be a regular file or a symlink to one."
  return 1
fi
mkdir -p -- "$sshDir"
chmod 700 "$sshDir"
if [[ ! -L $HOME/.ssh ]]; then
  ln -s -- "$sshDir" "$HOME/.ssh"
fi

if [[ -e $sshDir/$archHostName || -L $sshDir/$archHostName ]]; then
  log_info "Preserving existing SSH key: $sshDir/$archHostName"
elif [[ -e $sshDir/$archHostName.pub || -L $sshDir/$archHostName.pub ]]; then
  log_fail "Public key already exists without its private key: $sshDir/$archHostName.pub"
  return 1
else
  ssh-keygen -t ed25519 -f "$sshDir/$archHostName" -C "${gitUserName:-user}@$archHostName"
fi

chmod 600 "$sshDir/$archHostName"
if [[ ! -f $sshDir/$archHostName.pub ]]; then
  (
    public_key=$(mktemp "$sshDir/.public-key.XXXXXXXX")
    trap 'rm -f -- "$public_key"' EXIT
    ssh-keygen -y -f "$sshDir/$archHostName" > "$public_key"
    mv -- "$public_key" "$sshDir/$archHostName.pub"
  )
fi
if [[ -f $sshDir/$archHostName.pub ]]; then
  chmod 644 "$sshDir/$archHostName.pub"
fi

# Preserve local settings on subsequent runs.
if [[ ! -e $sshDir/config && ! -L $sshDir/config ]]; then
  (
    umask 077
    while IFS= read -r line || [[ -n $line ]]; do
      printf '%s\n' "${line//ARCH-HOST-NAME/$archHostName}"
    done < "$template" > "$sshDir/config"
  )
fi

touch "$sshDir/config.vim"
safe_link "$sshDir/config.vim" "$HOME/.config.vim"
