#!/usr/bin/env bash
# mirrors

if [[ ${mirrorFlag:-false} == true ]]; then
  log_info 'Updating archlinux mirrors.'
else
  log_info 'Skipping archlinux mirrors.'
  return;
fi

if ! command -v reflector &>/dev/null; then
  log_info 'Install reflector'
  sudo pacman -S --noconfirm --noprogressbar --needed reflector
else
  log_info 'Install reflector skipped'
fi

log_info "Updating mirrors for ${reflectorLocation}"
(
  mirrorlist=$(mktemp)
  trap 'rm -f -- "$mirrorlist"' EXIT
  reflector -c "$reflectorLocation" -f 12 -l 10 -n 12 --save "$mirrorlist"
  grep -q '^Server[[:space:]]*=' "$mirrorlist" || {
    log_fail "Reflector produced no usable servers."
    exit 1
  }
  install_system_file "$mirrorlist" /etc/pacman.d/mirrorlist
)
