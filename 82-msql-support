#!/usr/bin/env bash
# MS SQL client dependencies
set -euo pipefail

# ---------------------------------------------------------------------------
# Flag check
# ---------------------------------------------------------------------------
if [[ ${sqlFlag:-false} == true ]]; then
  log_info "Installing MS SQL support."
else
  log_warn "MS SQL support skipped."
  return;
fi

# Install MS SQL Suppport
sudo pacman -S --noconfirm --noprogressbar --needed unixodbc freetds
hash -r

