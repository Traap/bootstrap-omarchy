# Personal customization for an already-installed Omarchy 4.5+ system.
# All migration steps are opt-in. Stock packages/services remain Omarchy-owned.
# See README.md for retired flags, aliases and the upgrade procedure.

# Join the configured Active Directory domain (site-specific).
adFlag=false

# Repair DNS/NSS/SSSD for an existing AD membership; does not rejoin.
adRepairFlag=false

# Install an alternative personal Bash Git Prompt; stock Starship already exists.
bashGitPromptFlag=false

# Compose personal Bash startup files with the Omarchy defaults.
bashrcFlag=false

# Install the selected Brave variant through Omarchy browser integration.
braveBrowserFlag=false

# Clone the personal gits repository collection under cloneRoot.
cloneReposFlag=false

# Install EVDI/DisplayLink for a connected dock, independently of power policy.
displayLinkFlag=false

# Apply dockerServiceMode to the already-installed Docker services.
dockerServiceFlag=false

# Install the personal gits tool and configure its repository collection.
gitsFlag=false

# Link personal Hyprland Lua overrides; Hyprland is already installed.
hyprlandOverridesFlag=false

# Install additional Lua 5.1 rocks for personal Neovim plugins.
luaRocksPackagesFlag=false

# Opt in to changing the configured pacman mirrors.
mirrorFlag=false

# Install extra npm CLI tools using the selected/inherited mise Node runtime.
nodePackagesFlag=false

# Install the personal nvims Neovim switching tool.
nvimSwitcherFlag=false

# Opt out of the packaged omarchy-nvim configuration; preserve nvim.
omarchyNvimFlag=false

# Install extra personal repository packages, excluding the stock desktop tools.
pacmanPackagesFlag=false

# Install isolated Python CLI applications through pipx.
pythonCliPackagesFlag=false

# Install Rails using the explicitly configured rubyVersion; SQL clients are separate.
railsFlag=false

# Install/enable the selected local Redis/Valkey provider for applications.
redisFlag=false

# Select the explicit rubyVersion globally through packaged mise.
rubyFlag=false

# Link personal Omarchy Shell JSON overrides.
shellConfigFlag=false

# Customize number-based Snapper retention; preserve creation and boot integration.
snapshotRetentionFlag=false

# Install UnixODBC/FreeTDS client support; does not install a database server.
sqlFlag=false

# Ensure OpenSSH client tools are installed; does not enable incoming connections.
sshClientFlag=false

# Create/preserve the personal SSH authentication identity named sshKeyName.
sshIdentityFlag=false

# Independently install, validate, and enable the incoming SSH server.
sshServerFlag=false

# Link personal dotfiles, including the canonical XDG tmux directory.
symlinksFlag=false

# Install the selected optional TeX collections.
texPackagesFlag=false

# Configure sensors/dock drivers on detected ThinkPads; preserve power policy.
thinkpadSupportFlag=false

# Explicitly replace the current power-profiles provider with TLP on a ThinkPad.
thinkpadTlpFlag=false

# Install personal TPM plugins using an isolated tmux server.
tmuxPluginsFlag=false

# Install/configure the site-specific SNX-RS client with certificate checks.
vpnFlag=false

# Install Visual Studio Code through Omarchy AUR package management.
vscodeFlag=false

# Link a legacy Waybar configuration; requires targetProfile=legacy-waybar.
waybarFlag=false

# Merge WSL settings; requires targetProfile=wsl and an actual WSL kernel.
wslFlag=false

# Install optional legacy X11 tools separately from the Wayland package overlay.
x11ToolsFlag=false

# Profile gates: desktop, legacy-waybar, or wsl. A profile does not enable flags.
targetProfile=desktop

# Personal repositories and dotfiles.
cloneRoot=$HOME/git
dotfiles=$HOME/git/dotfiles

# SSH key comment and identity filename (does not set the system hostname).
gitUserName="Traap"
sshKeyName=DarkKnight

# Intentional application runtime override; keep native defaults if not needed.
rubyVersion='ruby@4'
# Optional explicit mise token, e.g. node@24; blank preserves inherited selection.
nodeVersion=''

# Browser integration: brave or brave-origin.
braveVariant=brave
# Docker startup: socket (Omarchy default) or daemon. No docker-group changes.
dockerServiceMode=socket

# Custom root snapshot retention (normal/important counts are independent).
# Defaults match the current Omarchy template; edit before enabling the flag.
snapshotConfigName=root
snapshotNumberLimit=5
snapshotImportantLimit=5
snapshotMinAge=0

# Only the WSL step uses these; they do not change a native desktop's hostname.
wslHostName=DarkKnight
wslUserName=traap

reflectorLocation="United States"

# Site-specific AD integration.
AD_DOMAIN="ent.co.ventura.ca.us"
AD_REALM="ENT.CO.VENTURA.CA.US"
AD_DNS1="10.130.5.98"
AD_DNS2="10.130.5.100"
AD_USER="135272"

# Site-specific VPN parameters; obtain the login type from the server.
VPN_LOGIN_TYPE="vpn"
VPN_SERVER="157.145.220.225"
VPN_TUNNEL_TYPE="ipsec"
