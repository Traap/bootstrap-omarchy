#!/usr/bin/env bash
# bravebrowser

if [[ ${braveBrowserFlag:-false} == true ]]; then
  log_info "Installing Brave Browser..."
else
  log_info "Brave Browser skipped."
  return;
fi

# Add Brave browser
if ! command -v curl &>/dev/null; then
  log_fail "curl command not found — ensure curl is installed."
  return;
fi

installer="$(mktemp)"
curl --proto '=https' --tlsv1.2 -fsSL https://dl.brave.com/install.sh -o "$installer"
sh "$installer"
rm -f "$installer"
