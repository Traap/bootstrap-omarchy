#!/usr/bin/env bash
if [[ ${braveBrowserFlag:-false} != true ]]; then
  log_info 'Brave Browser skipped.'
  return 0
fi
case ${braveVariant:-brave} in
  brave|brave-origin) ;;
  *) log_fail 'braveVariant must be brave or brave-origin.'; return 1 ;;
esac
require_cmd omarchy
# The native installer configures browser policy, flags and lifecycle hooks.
omarchy install browser "${braveVariant:-brave}"
