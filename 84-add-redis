#!/usr/bin/env bash
# redis

if [[ ${redisFlag:-false} == true ]]; then
  log_info 'Install redis.'
else
  log_info 'redis skipped.'
  return;
fi

# Preserve an existing Redis installation; otherwise use Arch's Redis provider.
if pacman -Q redis &>/dev/null; then
  redis_package=redis
  redis_service=redis.service
else
  redis_package=valkey
  redis_service=valkey.service
fi
sudo pacman -S --noconfirm --noprogressbar --needed "$redis_package"
sudo systemctl enable --now "$redis_service"
