#!/usr/bin/env bash
# Rails

if [[ ${railsFlag:-false} == true ]]; then
  log_info "Installing Rails..."
else
  log_info "Rails skipped."
  return;
fi

# Install pacman packages.
pacman_packages=(
  "freetds"
)

sudo pacman -S --noconfirm --noprogressbar --needed "${pacman_packages[@]}"

# Select the same Ruby explicitly in every migration subprocess.
require_cmd mise
mise exec "$rubyVersion" -- gem install rails
mise exec "$rubyVersion" -- rails --version
log_pass "Rails installed successfully."
