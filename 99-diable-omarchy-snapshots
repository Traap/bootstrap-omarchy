#!/usr/bin/env bash
# Disable automatic snapshot scheduling; preserve all existing snapshots.
if [[ ${snapshotFlag:-false} != true ]]; then
  log_info 'Disabling automatic snapshots skipped.'
  return 0
fi
for unit in snapper-timeline.timer snapper-cleanup.timer limine-snapper-sync.service; do
  load_state=$(systemctl show --property=LoadState --value "$unit")
  if [[ $load_state == not-found ]]; then
    log_info "Unit is not installed; skipping: $unit"
    continue
  fi
  sudo systemctl disable --now "$unit"
done
log_pass 'Automatic snapshot units disabled; existing snapshots preserved.'
