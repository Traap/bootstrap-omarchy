#!/usr/bin/env bash
if [[ ${vpnFlag:-false} != true ]]; then
  log_info 'VPN skipped.'
  return 0
fi
require_cmd yay python3
# Use upstream's supported Arch package rather than an unmanaged /opt build.
sudo pacman -S --noconfirm --noprogressbar --needed remmina freerdp libvncserver
yay -S --noconfirm --noprogressbar --needed snx-rs
require_cmd snx-rs

# Command mode reads this per-user flat key=value file (not TOML in /etc).
(
  vpn_dir=$(mktemp -d)
  trap 'rm -rf -- "$vpn_dir"' EXIT
  umask 077
  vpn_config="${XDG_CONFIG_HOME:-$HOME/.config}/snx-rs/snx-rs.conf"
  if [[ -f $vpn_config ]]; then
    cat "$vpn_config"
  fi | python3 "$MIGRATION_ROOT/scripts/update-vpn.py" \
    "$VPN_SERVER" "$VPN_LOGIN_TYPE" "$VPN_TUNNEL_TYPE" > "$vpn_dir/snx-rs.conf"
  install_user_file "$vpn_dir/snx-rs.conf" "$vpn_config" 0600
)
log_pass 'VPN installed with certificate verification enabled; no connection was started.'
