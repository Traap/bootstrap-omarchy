#!/usr/bin/env bash
# pacman packages

if [[ ${pacmanPackagesFlag:-false} == true ]]; then
  log_info 'Install pacman packages.'
else
  log_info 'pacman packages skipped.'
  return;
fi

# Install pacman packages.
pacman_packages=(
  "cmake"
  "flameshot"
  "freerdp"
  "ghostty"
  "go"
  "graphviz"
  "luacheck"
  "meld"
  "ninja"
  "pandoc-cli"
  "python-pynvim"
  "ripgrep-all"
  "selene"
  "stylua"
  "vim"
  "wget"
  "which"
  "yazi"
)

sudo pacman -S --noconfirm  --noprogressbar --needed "${pacman_packages[@]}"
hash -r
