#!/usr/bin/env bash
# Repair DNS, NSS and home-directory creation for an existing AD setup.
if [[ ${adRepairFlag:-false} != true ]]; then
  log_info 'Active Directory repair skipped.'
  return 0
fi
require_cmd sssctl
sudo test -s /etc/sssd/sssd.conf || {
  log_fail 'No SSSD configuration exists; enable adFlag to join first.'
  return 1
}
source "$MIGRATION_ROOT/scripts/ad-access.sh"
sudo sssctl config-check
sudo systemctl enable --now sssd.service
sudo systemctl restart sssd.service
sudo net ads testjoin
log_pass 'Active Directory repair verified.'
