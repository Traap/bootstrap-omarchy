#!/usr/bin/env bash
# orphaned

if [[ ${orphanedFlag:-false} == true ]]; then
  log_info 'Remove orphaned packages.'
else
  log_info 'Orphaned removal skipped.'
  return;
fi

# Removed orphaned packages.
# pacman exits 1 for an empty result. Verify database access separately.
pacman -Qq >/dev/null
orphan_list=$(pacman -Qdtq) || {
  orphan_status=$?
  [[ $orphan_status == 1 && -z $orphan_list ]] || return "$orphan_status"
}
orphans=()
if [[ -n $orphan_list ]]; then
  mapfile -t orphans <<< "$orphan_list"
fi
if ((${#orphans[@]})); then
  sudo pacman -Rns --noconfirm "${orphans[@]}"
else
  echo "No orphans found."
fi
