#!/usr/bin/env bash
# bashrc

if [[ ${bashrcFlag:-false} == true ]]; then
  echo 'Install .bashrc.'
else
  log_info '.bashrc skipped.'
  return;
fi

# Render before replacing files; identical reruns need no additional backups.
(
  shell_dir=$(mktemp -d)
  trap 'rm -rf -- "$shell_dir"' EXIT
  omarchy_bash_rc="${OMARCHY_PATH:-/usr/share/omarchy}/default/bash/rc"
  if [[ ! -f $omarchy_bash_rc ]]; then
    omarchy_bash_rc="$HOME/.local/share/omarchy/default/bash/rc"
  fi
  printf '%s\n' '# ~/.bash_profile' '[[ -f ~/.bashrc ]] && . ~/.bashrc' > "$shell_dir/bash_profile"
  {
    printf '%s\n' '# ~/.bashrc' '# Omarchy defaults'
    printf '[[ -f %q ]] && . %q\n' "$omarchy_bash_rc" "$omarchy_bash_rc"
    printf '\n# Personal configuration\n'
    printf '[[ -f %q ]] && . %q\n' "$dotfiles/bash/bashrc" "$dotfiles/bash/bashrc"
    printf '\n%s\n' 'if [[ $- == *i* && -f ~/.inputrc ]]; then bind -f ~/.inputrc; fi'
  } > "$shell_dir/bashrc"
  bash -n "$shell_dir/bash_profile"
  bash -n "$shell_dir/bashrc"
  install_user_file "$shell_dir/bash_profile" "$HOME/.bash_profile"
  install_user_file "$shell_dir/bashrc" "$HOME/.bashrc"
)
