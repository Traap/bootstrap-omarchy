#!/usr/bin/env bash
# cloneRepos

if [[ ${cloneReposFlag:-false} == true ]]; then
  log_info 'Cloning repos.'
else
  log_info 'Cloning repos skipped.'
  return
fi

# Use a private copy so cloneRoot is honored without overwriting local settings.
require_cmd gits python3
(
  locations_dir=$(mktemp -d)
  trap 'rm -rf -- "$locations_dir"' EXIT
  mkdir -p "$locations_dir/gits"
  python3 "$MIGRATION_ROOT/scripts/repository-locations.py" "$MIGRATION_ROOT/repository_locations.yml" "$cloneRoot" > "$locations_dir/gits/repository_locations.yml"
  XDG_CONFIG_HOME="$locations_dir" gits clone -r git -v
)
